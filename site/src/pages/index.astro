---
import Base from '../layouts/Base.astro';
import PublicWriting from '../components/PublicWriting.astro';
import Contact from '../components/Contact.astro';
import {profile, projects} from '../data/profile';
---
<Base title="Builder" description="Ojaas Hampiholi is a builder, learner, and teacher who likes exploring how technology works, turning ideas into useful systems, and making what he learns easier for others to understand and build on.">
<div class="wrap">
<section class="hero">
  <p class="eyebrow">Data scientist · AI engineer · ML engineer</p>
  <h1>{profile.headline}</h1>
  <p class="intro">{profile.intro}</p>
  <div class="actions"><a class="button" href="/work/">See the work <span aria-hidden="true">↗</span></a><a class="text-link" href="#contact">Write to me</a></div>
</section>
<section class="section">
  <div class="section-heading"><h2>Projects</h2><a class="text-link" href="/work/">All work <span aria-hidden="true">↗</span></a></div>
  {projects.map(p=><article class="work-row"><p class="eyebrow">{p.hat}</p><h3><a href={`/work/${p.slug}/`}>{p.name}</a></h3><p>{p.summary}</p></article>)}
</section>
<PublicWriting compact/>
<Contact/>
</div>
</Base>
