---
import '../styles/global.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import '@fontsource/nunito/700.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import { profile, identities, outside } from '../data/profile';
import { expertiseTerms } from '../data/search-terms';
import writing from '../data/public-writing.json';
interface Props { title: string; description: string; noindex?: boolean; article?: Record<string,unknown>; kind?: 'about' | 'writing' }
const { title, description, noindex=false, article, kind } = Astro.props;
const indexable=import.meta.env.PUBLIC_INDEXABLE==='true' && !noindex;
const canonical=new URL(Astro.url.pathname,Astro.site);
const personId=new URL('/#person',Astro.site).href;
const blogId=new URL('/writing/#blog',Astro.site).href;
const person={'@type':'Person','@id':personId,name:profile.name,jobTitle:profile.role,description:profile.intro,url:new URL('/about/',Astro.site).href,sameAs:identities.map(item=>item.url),knowsAbout:[...expertiseTerms.map(term=>term.query),...writing.themes.filter(theme=>theme.source==='LinkedIn'||theme.source==='Medium').map(theme=>theme.label)],alumniOf:[{'@type':'CollegeOrUniversity',name:'Indiana University Bloomington'},{'@type':'CollegeOrUniversity',name:'University of Mumbai'}],worksFor:{'@type':'Organization',name:'Samsung Electronics America'}};
const schema={'@context':'https://schema.org','@graph':[
 person,
 {'@type':'WebSite','@id':new URL('/#website',Astro.site).href,url:Astro.site?.href,name:profile.name,publisher:{'@id':personId},author:{'@id':personId}},
 ...(kind==='about'?[{'@type':'ProfilePage','@id':canonical.href+'#profile',url:canonical.href,mainEntity:{'@id':personId},about:{'@id':personId}}]:[]),
 ...(kind==='writing'||article?[{'@type':'Blog','@id':blogId,name:'Writing by Ojaas Hampiholi',url:new URL('/writing/',Astro.site).href,author:{'@id':personId}}]:[]),
 ...(article?[{'@type':'BlogPosting',...article,isPartOf:{'@id':blogId},author:{'@id':personId},mainEntityOfPage:canonical.href}]:[])
]};
const nav=[['/work/','Work'],['/writing/','Writing'],['/about/','About']];
const mailto=`mailto:${profile.email}?subject=${encodeURIComponent('A note')}`;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Ojaas Hampiholi</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index, follow':'noindex, follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="Ojaas Hampiholi — Writing" href="/rss.xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><meta name="author" content={profile.name}/>{identities.map(item=><link rel="me" href={item.url}/>)}<link rel="alternate" type="text/plain" href="/llms.txt" title="Site guide for language models"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/></head>
<body><a class="skip" href="#main">Skip to content</a><header class="header wrap"><a class="identity" href="/" aria-label="Ojaas Hampiholi — home"><span class="monogram" aria-hidden="true">oh.</span><span>Ojaas Hampiholi</span></a><nav aria-label="Main navigation">{nav.map(([url,label])=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}>{label}</a>)}<a class="contact-link" href={mailto}>Write to me <span aria-hidden="true">↗</span></a></nav></header><main id="main" tabindex="-1"><slot/></main><footer class="wrap footer"><div><strong>Ojaas Hampiholi</strong><p>Builder. Data scientist, AI engineer, and ML engineer, depending on the project.</p><p class="motion-control"><label><input id="pause-motion" type="checkbox"/> Pause motion</label></p></div><div class="footer-links">{[...identities,...outside].map(item=><a rel="me" href={item.url}>{item.name}</a>)}<a href="/rss.xml">RSS</a><a href="/llms.txt">llms.txt</a></div><small>© {new Date().getFullYear()} Ojaas Hampiholi</small></footer></body></html>
