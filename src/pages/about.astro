---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Elsewhere from '../components/Elsewhere.astro';
import {existsSync} from 'node:fs';
import {profile} from '../data/profile';
import {sitePath} from '../data/paths';
const resume=existsSync(new URL('../../public/resume.pdf',import.meta.url));
---
<Base kind="about" title="About" description="About Ojaas Hampiholi, a builder, learner, and teacher. Experience at Samsung and Amazon, education, and the other pages published under the same name.">
<div class="wrap">
<header class="page-head"><p class="eyebrow">About</p><h1>{profile.headline}</h1><p>{profile.intro}</p></header>
<section class="section"><div class="section-heading"><h2>Experience</h2><span>{resume&&<a class="text-link" href={sitePath('/resume.pdf')}>Résumé <span aria-hidden="true">↗</span></a>} <a class="text-link" href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></span></div><div class="timeline"><div class="date">JAN 2023 — PRESENT</div><div><h3>Samsung Electronics America</h3><p><strong>Data Scientist, Customer Intelligence</strong></p><p>Segmentation, propensity modeling, and ML decision systems for the TV business. Managed an eight-member team and directly led a three-person team on support automation.</p></div></div><div class="timeline"><div class="date">JUN 2021 — JAN 2023</div><div><h3>Amazon</h3><p><strong>Software Development Engineer, Payments ML</strong></p><p>Payment ranking, ML observability, and data compliance workflows. Mentored engineers contributing to ML systems.</p></div></div><div class="timeline"><div class="date">2020 — 2021</div><div><h3>Teaching and applied data science</h3><p>Graduate teaching assistant at Indiana University Bloomington, including graduate-level Data Visualization. Data science internship at TechPoint on regional COVID-19 forecasting.</p></div></div></section>
<section class="section"><h2>Education</h2><h3 style="margin-top:22px">MS, Data Science</h3><p>Indiana University Bloomington · 2019–2021</p><h3 style="margin-top:28px">BE, Electronics and Telecommunications</h3><p>University of Mumbai · 2015–2019</p></section>
<section class="section"><h2>Outside the job</h2><p style="margin-top:18px">Raspberry Pi projects, football, pickleball, and poetry in English and Hindi.</p></section>
<Elsewhere/>
<Contact/>
</div>
</Base>
